# 복사해서 .env 로 쓰세요. .env 는 추적하지 않습니다.

# OpenAI 호환 엔드포인트
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# 쪽 전사용 (양이 많음, 싼 티어)
LLM_MODEL_VISION=gpt-5.6-luna

# 문항 조립·정답 대조·관계 추출용 (양이 적음, 강한 티어)
LLM_MODEL_STRUCT=gpt-5.6-luna

# 동시 실행 수. 429가 뜨면 낮추세요.
CONCURRENCY=4

# 원본 루트. 읽기 전용입니다.
SOURCE_ROOT=G:\내 드라이브\여형준님\32 공부 자료

# poppler bin 경로. 비우면 PATH 와 알려진 WinGet 경로에서 찾습니다.
POPPLER_BIN=
